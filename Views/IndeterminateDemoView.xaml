<UserControl
    x:Class="ProgressBarDemo.Views.IndeterminateDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProgressBarDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Bold"
                Text="不确定模式ProgressBar示例" />

            <TextBlock
                Margin="0,0,0,10"
                Text="不确定模式（IsIndeterminate=True）使用场景："
                TextWrapping="Wrap" />

            <TextBlock
                Margin="20,0,0,5"
                Text="- 无法估计操作完成时间"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="20,0,0,5"
                Text="- 无法计算进度百分比"
                TextWrapping="Wrap" />

            <TextBlock
                Margin="20,0,0,20"
                Text="- 需要向用户展示'正在处理'的状态"
                TextWrapping="Wrap" />

            <!--  不确定模式进度条  -->
            <TextBlock Margin="0,0,0,5" Text="不确定模式进度条:" />
            <ProgressBar
                Height="15"
                Margin="0,0,0,20"
                IsIndeterminate="{Binding IsIndeterminate}" />

            <!--  确定模式进度条  -->
            <TextBlock Margin="0,0,0,5" Text="确定模式进度条:" />
            <ProgressBar
                Height="15"
                Margin="0,0,0,20"
                IsIndeterminate="{Binding IsIndeterminate, Converter={StaticResource BooleanToOppositeBooleanConverter}}"
                Maximum="100"
                Minimum="0"
                Value="{Binding ProgressValue}" />

            <!--  切换按钮  -->
            <Button
                Width="200"
                HorizontalAlignment="Left"
                Command="{Binding ToggleIndeterminateCommand}"
                Content="{Binding IsIndeterminate, Converter={StaticResource IndeterminateButtonTextConverter}}" />

            <TextBlock Margin="0,20,0,5" Text="当前模式:" />
            <TextBlock FontWeight="Bold" Text="{Binding IsIndeterminate, Converter={StaticResource IndeterminateModeTextConverter}}" />
        </StackPanel>
    </Grid>
</UserControl> 