<UserControl
    x:Class="ProgressBarDemo.Views.FileDownloadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProgressBarDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Bold"
                Text="文件下载进度条示例" />

            <TextBlock
                Margin="0,0,0,20"
                Text="此示例模拟一个文件下载过程，演示了如何显示下载速度、已下载大小和剩余时间等信息。"
                TextWrapping="Wrap" />

            <!--  文件下载进度条  -->
            <Grid>
                <ProgressBar
                    Height="20"
                    Margin="0,0,0,5"
                    Value="{Binding ProgressValue}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding ProgressValue, StringFormat={}{0:0.0}%}" />
            </Grid>

            <!--  详细信息  -->
            <Grid Margin="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,5"
                    FontWeight="SemiBold"
                    Text="状态:" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,5"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    FontWeight="SemiBold"
                    Text="文件大小:" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    Text="{Binding TotalBytes, Converter={StaticResource FileSizeConverter}}" />
            </Grid>

            <!--  操作按钮  -->
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="0,0,10,0"
                    Command="{Binding StartDownloadCommand}"
                    Content="开始下载" />
                <Button
                    Width="100"
                    Command="{Binding CancelDownloadCommand}"
                    Content="取消" />
            </StackPanel>

            <TextBlock
                Margin="0,20,0,0"
                FontStyle="Italic"
                Foreground="Gray"
                Text="提示: 在展示进度信息时，提供额外的详细信息（如下载速度和剩余时间）可以大幅提升用户体验。"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl> 