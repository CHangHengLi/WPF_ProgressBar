<UserControl
    x:Class="ProgressBarDemo.Views.BasicDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProgressBarDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AntiqueWhite"
    mc:Ignorable="d">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,20"
                FontSize="18"
                FontWeight="Bold"
                Text="基本ProgressBar示例" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!--  基本进度条  -->
                    <TextBlock Margin="0,0,0,5" Text="标准进度条:" />
                    <ProgressBar
                        Height="20"
                        Margin="0,0,0,15"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding ProgressValue}" />

                    <!--  带标签的进度条  -->
                    <TextBlock Margin="0,0,0,5" Text="带数值的进度条:" />
                    <Grid Margin="0,0,0,15">
                        <ProgressBar
                            Height="25"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressValue}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding ProgressValue, StringFormat={}{0:0}%}" />
                    </Grid>

                    <!--  垂直进度条  -->
                    <TextBlock Margin="0,0,0,5" Text="垂直进度条:" />
                    <ProgressBar
                        Width="20"
                        Height="150"
                        Margin="50,0,0,15"
                        Maximum="100"
                        Minimum="0"
                        Orientation="Vertical"
                        Value="{Binding ProgressValue}" />
                </StackPanel>

                <!--  控制面板  -->
                <StackPanel
                    Grid.Column="1"
                    Width="150"
                    Margin="20,0,0,0">
                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Text="控制面板" />

                    <TextBlock Margin="0,0,0,5" Text="当前值:" />
                    <TextBlock
                        Margin="0,0,0,15"
                        FontWeight="Bold"
                        Text="{Binding ProgressValue, StringFormat={}{0:0.0}}" />

                    <TextBlock Margin="0,0,0,5" Text="增量:" />
                    <Slider
                        Margin="0,0,0,15"
                        LargeChange="5"
                        Maximum="20"
                        Minimum="1"
                        SmallChange="1"
                        Value="{Binding Increment}" />
                    <TextBlock Margin="0,0,0,15" Text="{Binding Increment, StringFormat=增量: {0:0}}" />

                    <Button
                        Margin="0,0,0,5"
                        Command="{Binding IncreaseCommand}"
                        Content="增加" />
                    <Button
                        Margin="0,0,0,5"
                        Command="{Binding DecreaseCommand}"
                        Content="减少" />
                    <Button
                        Margin="0,0,0,5"
                        Command="{Binding ResetCommand}"
                        Content="重置" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl> 